  "source": {
    "name": "grid.cpp",
    "text": "int dp[3][3] = {};\n\nint main() {\n    for (int row = 0; row < 3; ++row) {\n        for (int col = 0; col < 3; ++col) {\n            if (row == 0 || col == 0) {\n                dp[row][col] = 1;\n            } else {\n                dp[row][col] = dp[row - 1][col] + dp[row][col - 1];\n            }\n        }\n    }\n    return dp[2][2] == 6 ? 0 : 1;\n}\n"
  }
